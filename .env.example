# Clave de la API de Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Modelo (opcional)
GEMINI_MODEL=gemini-2.5-flash

# ID de la carpeta de Drive: es lo que va después de /folders/ en su URL
GOOGLE_DRIVE_FOLDER_ID=

# Cuenta de servicio: correo (client_email) y clave privada (private_key) del JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Alternativa: en vez de las dos de arriba, el JSON completo en una línea (o en base64)
# GOOGLE_SERVICE_ACCOUNT_JSON=
