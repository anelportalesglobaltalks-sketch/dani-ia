# Clave de la API de Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Modelo (opcional)
GEMINI_MODEL=gemini-2.5-flash

# ID de la carpeta de Drive: es lo que va después de /folders/ en su URL
DRIVE_FOLDER_ID=

# Contenido COMPLETO del JSON de la cuenta de servicio (en una sola línea),
# o ese mismo JSON codificado en base64
GOOGLE_SERVICE_ACCOUNT_JSON=
